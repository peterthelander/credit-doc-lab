# Copy to .env (git-ignored) and fill in, or set a key in the environment.
# Get a key at https://aistudio.google.com/apikey
# Extraction also accepts GOOGLE_API_KEY, which takes precedence when both are set.
GEMINI_API_KEY=
# Optional: model used by `extract`/`batch` when --model is not given
# CREDIT_DOC_LAB_MODEL=
# Optional: LLM judge model for `evaluate --scorer official` (LiteLLM model id)
# CREDIT_DOC_LAB_JUDGE_MODEL=gemini/gemini-2.5-flash
